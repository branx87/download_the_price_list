# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Chat ID для уведомлений планировщика
# (отправь /start боту и посмотри chat_id в логах)
NOTIFY_CHAT_ID=

# База данных
DATABASE_URL=sqlite:///prices.db

# Порог изменения цены (%)
PRICE_CHANGE_THRESHOLD=5.0

# Прокси (опционально, если Telegram заблокирован)
# Форматы: socks5://user:pass@host:port, http://user:pass@host:port
PROXY_URL=

# --- MSSQL (если используется вместо SQLite) ---
# MSSQL_SERVER=192.168.1.100
# MSSQL_DATABASE=Total_Price
# MSSQL_USERNAME=sa
# MSSQL_PASSWORD=
# MSSQL_TRUST_CERT=yes

# --- 1C-ERP интеграция ---
# ERP_BASE_URL=http://your-erp-server/api
# ONE_C_LOGIN=
# ONE_C_PASSWORD=

# Фильтры 1C-ERP (через запятую):
# Производители, которых НЕ загружать в БД
# ERP_SKIP_MANUFACTURERS=ШИНА,RSVET,МЕКО,MEKO,ООО "ЕРС-КОМПЛЕКТ"
# Типы номенклатуры, которые НЕ загружать в БД (skip list)
# ERP_SKIP_ITEM_TYPES=Товары на складах (41)
# Типы номенклатуры, которые загружать в БД (allow list, приоритетнее skip list)
# Если задан — пропускаются ТОЛЬКО перечисленные виды
# ERP_ALLOWED_ITEM_TYPES=Сырье и материалы (10.01),Лакокрасочные материалы (ЛКМ) (10.06),Товары на складах (41)

# --- Планировщик ---
# ERP: время синхронизации (часы через запятую, или HH:MM)
# Примеры: "8,13,18" или "8:00,13:30,18:00"
ERP_SYNC_TIMES=8,13,18

# Синхронизация прайсов: день недели и время
# День: 0=Пн, 1=Вт, ..., 6=Вс
SYNC_ALL_DAY=0
# Время: HH:MM
SYNC_ALL_TIME=6:00

# --- DKC авторизация ---
# DKC_LOGIN=branx
# DKC_PASSWORD=

# --- Bitrix24 Bot ---
# REST webhook URL (https://your.bitrix24.ru/rest/<user_id>/<token>/)
# Нужен для отправки ответов из фоновых задач (sync/check) и алертов
BITRIX_REST_URL=

# ID бота (из imbot.register или настроек Bitrix24)
BITRIX_BOT_ID=0

# Bitrix24 user ID администраторов (через запятую)
# Только они могут управлять ботом через B24-чат
B24_ADMIN_IDS=

# Порт FastAPI-сервера (PHP-relay должен знать этот порт)
B24_BOT_PORT=7778

# Токен для проверки X-Webhook-Token (ставь одинаковый в PHP и здесь)
B24_WEBHOOK_TOKEN=

# ID группового чата для алертов (берётся из URL: /im/chat/22191/ → chat22191)
BITRIX_ALERT_CHAT_ID=
